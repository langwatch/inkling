{"id": "contrast_formula-22", "q": "contrast_formula", "yes": true, "text": "There's no magic involved here, only a cron job running every hour.", "rule": "banned-words/magic-reframe", "mode": "post", "orig": false}
{"id": "contrast_formula-23", "q": "contrast_formula", "yes": false, "text": "The export takes 40 seconds for a thousand rows, so we moved it to a background job.", "rule": null, "mode": "post", "orig": false}
