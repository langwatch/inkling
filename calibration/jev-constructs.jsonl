{"id": "mirrored_pair-29", "q": "mirrored_pair", "yes": true, "text": "Policies attest. Evidence proves.", "rule": "contrast/mirrored-pair", "mode": "post", "orig": true}
{"id": "mirrored_pair-30", "q": "mirrored_pair", "yes": true, "text": "Policies only attest, while evidence actually proves.", "rule": "contrast/mirrored-pair", "mode": "post", "orig": false}
{"id": "mirrored_pair-31", "q": "mirrored_pair", "yes": true, "text": "Dashboards count. Evals judge.", "rule": "contrast/mirrored-pair", "mode": "post", "orig": false}
{"id": "mirrored_pair-32", "q": "mirrored_pair", "yes": true, "text": "Your sandbox runs the agent; your team puts it to work.", "rule": "contrast/mirrored-pair", "mode": "post", "orig": false}
{"id": "mirrored_pair-33", "q": "mirrored_pair", "yes": true, "text": "Write the tests, test the writing.", "rule": "slogan/chiasmus", "mode": "post", "orig": true}
{"id": "mirrored_pair-34", "q": "mirrored_pair", "yes": true, "text": "We wrote the tests and then we tested the writing.", "rule": "slogan/chiasmus", "mode": "post", "orig": false}
{"id": "mirrored_pair-35", "q": "mirrored_pair", "yes": true, "text": "Read like a writer, and write the way a reader reads.", "rule": "slogan/chiasmus", "mode": "post", "orig": false}
{"id": "mirrored_pair-36", "q": "mirrored_pair", "yes": true, "text": "The more you paste in, the more leaks out.", "rule": "script/balanced-line", "mode": "script", "orig": true}
{"id": "mirrored_pair-37", "q": "mirrored_pair", "yes": true, "text": "Paste in more and more leaks out.", "rule": "script/balanced-line", "mode": "script", "orig": false}
{"id": "mirrored_pair-38", "q": "mirrored_pair", "yes": true, "text": "Whatever it knows about is whatever it writes about.", "rule": "script/balanced-line", "mode": "script", "orig": false}
{"id": "mirrored_pair-39", "q": "mirrored_pair", "yes": false, "text": "The judge reads every paragraph, and the readers answer the questions we wrote first.", "rule": null, "mode": "post", "orig": false}
{"id": "mirrored_pair-40", "q": "mirrored_pair", "yes": false, "text": "Tracing shows what ran; evals tell you whether it was right, so you need both before a release.", "rule": null, "mode": "post", "orig": false}
{"id": "mirrored_pair-41", "q": "mirrored_pair", "yes": false, "text": "We tried two prompts on the same 200 conversations and kept the one with fewer handoffs.", "rule": null, "mode": "post", "orig": false}
{"id": "mirrored_pair-42", "q": "mirrored_pair", "yes": false, "text": "Sales uses it for call notes and support uses it for refunds.", "rule": null, "mode": "post", "orig": false}
{"id": "mirrored_pair-43", "q": "mirrored_pair", "yes": false, "text": "If you paste in more context, the model writes about more of it.", "rule": null, "mode": "post", "orig": false}
{"id": "mirrored_pair-44", "q": "mirrored_pair", "yes": false, "text": "The agent reads the ticket and writes a reply.", "rule": null, "mode": "post", "orig": false}
{"id": "rule_of_three-45", "q": "rule_of_three", "yes": true, "text": "Too much overhead, too many handoffs, too much silent failure.", "rule": "contrast/rule-of-three", "mode": "post", "orig": true}
{"id": "rule_of_three-46", "q": "rule_of_three", "yes": true, "text": "There was too much overhead, there were too many handoffs and there was far too much silent failure.", "rule": "contrast/rule-of-three", "mode": "post", "orig": false}
{"id": "rule_of_three-47", "q": "rule_of_three", "yes": true, "text": "Less waiting. Less guessing. Less paging.", "rule": "contrast/rule-of-three", "mode": "post", "orig": false}
{"id": "rule_of_three-48", "q": "rule_of_three", "yes": true, "text": "Faster reviews, cheaper runs, happier teams.", "rule": "contrast/rule-of-three", "mode": "post", "orig": false}
{"id": "rule_of_three-49", "q": "rule_of_three", "yes": true, "text": "No setup, no keys, no waiting.", "rule": "contrast/rule-of-three", "mode": "post", "orig": false}
{"id": "rule_of_three-50", "q": "rule_of_three", "yes": false, "text": "The trace has three spans: retrieval, the model call and the tool call.", "rule": null, "mode": "post", "orig": false}
{"id": "rule_of_three-51", "q": "rule_of_three", "yes": false, "text": "We support Python, TypeScript and Go.", "rule": null, "mode": "post", "orig": false}
{"id": "rule_of_three-52", "q": "rule_of_three", "yes": false, "text": "It took three tries, two rewrites and a long night to fix.", "rule": null, "mode": "post", "orig": false}
