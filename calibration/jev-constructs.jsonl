{"id": "slogan_equation-216", "q": "slogan_equation", "yes": true, "text": "The reader? That's your spec.", "rule": "slogan/x-is-the-y", "mode": "post", "orig": false}
{"id": "slogan_equation-217", "q": "slogan_equation", "yes": false, "text": "The spec lists what the audience must take away.", "rule": null, "mode": "post", "orig": false}
{"id": "slogan_equation-218", "q": "slogan_equation", "yes": false, "text": "The test is a file of questions a reader must answer.", "rule": null, "mode": "post", "orig": false}
{"id": "slogan_equation-219", "q": "slogan_equation", "yes": false, "text": "The draft is 800 words long.", "rule": null, "mode": "post", "orig": false}
{"id": "slogan_equation-220", "q": "slogan_equation", "yes": false, "text": "The default is the production label.", "rule": null, "mode": "post", "orig": false}
{"id": "slogan_equation-221", "q": "slogan_equation", "yes": false, "text": "The goal is a sign-up from a founder who read the post.", "rule": null, "mode": "post", "orig": false}
{"id": "slogan_equation-222", "q": "slogan_equation", "yes": false, "text": "The first draft is the one we talked through out loud.", "rule": null, "mode": "post", "orig": false}
