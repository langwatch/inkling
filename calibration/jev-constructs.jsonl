{"id": "contrast_formula-14", "q": "contrast_formula", "yes": true, "text": "It records what agents actually did rather than what they meant.", "rule": "contrast/x-not-y-closer", "mode": "post", "orig": false}
{"id": "contrast_formula-15", "q": "contrast_formula", "yes": true, "text": "Your agent doesn't need a sandbox. It needs a team.", "rule": "contrast/doesnt-need-needs", "mode": "post", "orig": true}
{"id": "contrast_formula-16", "q": "contrast_formula", "yes": true, "text": "Your agent never needed a sandbox. What it needed was a team.", "rule": "contrast/doesnt-need-needs", "mode": "post", "orig": false}
{"id": "contrast_formula-17", "q": "contrast_formula", "yes": true, "text": "What your agent lacks isn't a sandbox; it's a team around it.", "rule": "contrast/doesnt-need-needs", "mode": "post", "orig": false}
{"id": "contrast_formula-18", "q": "contrast_formula", "yes": true, "text": "It didn't just change how we work, it changed who we are.", "rule": "contrast/didnt-just", "mode": "post", "orig": true}
{"id": "contrast_formula-19", "q": "contrast_formula", "yes": true, "text": "It hasn't merely changed our workflow; it has changed our whole company.", "rule": "contrast/didnt-just", "mode": "post", "orig": false}
