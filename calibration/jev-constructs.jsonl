{"id": "contrast_formula-25", "q": "contrast_formula", "yes": false, "text": "We don't store request bodies, and the proxy logs only status codes.", "rule": null, "mode": "post", "orig": false}
{"id": "contrast_formula-26", "q": "contrast_formula", "yes": false, "text": "The bug was in retrieval, which returned an empty context for long queries.", "rule": null, "mode": "post", "orig": false}
{"id": "contrast_formula-27", "q": "contrast_formula", "yes": false, "text": "Not every team needs the gateway on day one; start with tracing.", "rule": null, "mode": "post", "orig": false}
