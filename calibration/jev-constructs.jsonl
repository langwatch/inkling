{"id": "fake_epiphany-98", "q": "fake_epiphany", "yes": true, "text": "The lesson that changed everything: retrieval was broken.", "rule": "narrator/fake-epiphany", "mode": "post", "orig": false}
{"id": "fake_epiphany-99", "q": "fake_epiphany", "yes": false, "text": "The retrieval span showed contexts: [] for every long query.", "rule": null, "mode": "post", "orig": false}
{"id": "fake_epiphany-100", "q": "fake_epiphany", "yes": false, "text": "We found the bug on Tuesday, after reading forty traces.", "rule": null, "mode": "post", "orig": false}
