{"q": "guide_preamble", "rule": null, "mode": "docs", "yes": false, "text": "This guide builds an evaluation pipeline for a conversational agent.", "before": "", "orig": false, "id": "guide_preamble-73"}
{"q": "guide_preamble", "rule": null, "mode": "docs", "yes": false, "text": "Simulations run your agent against a scripted user and record every turn.", "before": "", "orig": false, "id": "guide_preamble-74"}
