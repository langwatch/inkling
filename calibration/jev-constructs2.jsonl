{"q": "timeline_when", "rule": "docs/timeline-when", "mode": "docs", "yes": true, "text": "When the data privacy policy drops content, the session keeps its cost.", "before": "", "orig": true, "id": "timeline_when-202"}
{"q": "timeline_when", "rule": "docs/timeline-when", "mode": "docs", "yes": true, "text": "Once the retention window passes, traces are deleted and only the costs remain.", "before": "", "orig": false, "id": "timeline_when-203"}
{"q": "timeline_when", "rule": "docs/timeline-when", "mode": "docs", "yes": true, "text": "After the nightly job runs, old spans disappear from the list.", "before": "", "orig": false, "id": "timeline_when-204"}
{"q": "timeline_when", "rule": "docs/timeline-when", "mode": "docs", "yes": true, "text": "As soon as the cache expires, the next request goes to the model.", "before": "", "orig": false, "id": "timeline_when-205"}
{"q": "timeline_when", "rule": null, "mode": "docs", "yes": false, "text": "You can drop the conversation content and keep the cost.", "before": "", "orig": false, "id": "timeline_when-206"}
{"q": "timeline_when", "rule": null, "mode": "docs", "yes": false, "text": "Set a retention window to delete traces after 30 days.", "before": "", "orig": false, "id": "timeline_when-207"}
{"q": "timeline_when", "rule": null, "mode": "docs", "yes": false, "text": "Traces older than the retention window are deleted; costs stay.", "before": "", "orig": false, "id": "timeline_when-208"}
{"q": "timeline_when", "rule": null, "mode": "docs", "yes": false, "text": "To clear the cache, run langwatch cache clear.", "before": "", "orig": false, "id": "timeline_when-209"}
{"q": "timeline_when", "rule": null, "mode": "docs", "yes": false, "text": "When you send a trace, the API returns its id.", "before": "", "orig": false, "id": "timeline_when-210"}
{"q": "timeline_when", "rule": null, "mode": "docs", "yes": false, "text": "If you set a privacy policy, the content is dropped and the cost kept.", "before": "", "orig": false, "id": "timeline_when-211"}
