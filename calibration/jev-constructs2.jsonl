{"q": "fragment_tagline", "rule": null, "mode": "post", "yes": false, "text": "The panel reads the draft, and the report lists where readers stopped.", "before": "", "orig": false, "id": "fragment_tagline-232"}
{"q": "fragment_tagline", "rule": null, "mode": "post", "yes": false, "text": "# Write the reader tests first", "before": "", "orig": false, "id": "fragment_tagline-233"}
{"q": "fragment_tagline", "rule": null, "mode": "post", "yes": false, "text": "# Laptop shut? It still works", "before": "", "orig": false, "id": "fragment_tagline-234"}
