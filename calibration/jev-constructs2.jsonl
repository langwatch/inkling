{"q": "narrated_flow", "rule": null, "mode": "post", "yes": false, "text": "Instant Evals judges 10,000 conversations in about a minute.", "before": "", "orig": false, "id": "narrated_flow-62"}
{"q": "narrated_flow", "rule": null, "mode": "post", "yes": false, "text": "Langy writes the query and draws the chart from your question.", "before": "", "orig": false, "id": "narrated_flow-63"}
{"q": "narrated_flow", "rule": null, "mode": "post", "yes": false, "text": "The query box takes a question and returns a chart and the SQL behind it.", "before": "", "orig": false, "id": "narrated_flow-64"}
{"q": "narrated_flow", "rule": null, "mode": "post", "yes": false, "text": "If the query fails, the chart shows the error and the line that broke.", "before": "", "orig": false, "id": "narrated_flow-65"}
